# Vidyarthi-IoT backend environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL / Supabase ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DATA_DIR=./data

# --- Attendance ---
AM_PM_CUTOFF_HOUR=12

# --- PM-POSHAN ---
GRAIN_G_PER_CHILD=100
PULSES_G_PER_CHILD=20
RATION_INITIAL_GRAIN_KG=0
RATION_INITIAL_PULSES_KG=0

# --- Dropout / equity early warning ---
DROPOUT_MISSED_THRESHOLD=5
RABI_MONTHS=11,12,1
KHARIF_MONTHS=6,7,8,9

# --- Telegram notifications (used as the SMS-compatible gateway) ---
# Leave dry-run enabled until the bot and webhook are configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DRY_RUN=true
TELEGRAM_WEBHOOK_SECRET=

# --- Legacy generic SMS variables (kept for compatibility; not used by the current Telegram gateway) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=SCHOOL
SMS_DRY_RUN=true
SMS_BATCH_HOUR=19
SMS_BATCH_MINUTE=30

# --- API security ---
# Set both keys in any deployment where devices/users are not on a fully trusted local LAN.
ADMIN_API_KEY=
TERMINAL_API_KEY=

# --- CORS ---
# For backend-served dashboard this is not required. Use * only for local development.
CORS_ORIGINS=*
